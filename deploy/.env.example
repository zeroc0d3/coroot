#================================================================================================
# Coroot Platform - Environment Configuration
# Copy this file to .env and customize the values for your environment
#================================================================================================

#================================================================================================
# GENERAL SETTINGS
#================================================================================================
TZ=UTC
VOLUMES_DRIVER=local

#================================================================================================
# SERVICE VERSIONS
#================================================================================================
PROMETHEUS_VERSION=v2.53.5
CLICKHOUSE_VERSION=24.3
NODE_AGENT_VERSION=latest
CLUSTER_AGENT_VERSION=latest

#================================================================================================
# COROOT CONFIGURATION
#================================================================================================
LICENSE_KEY=
# Host port mapping (container always uses 8080 internally)
PORT_COROOT_HOST=8080
CONTAINER_COROOT=coroot_main
CONTAINER_IP_COROOT=172.160.160.50

#================================================================================================
# PROMETHEUS CONFIGURATION
#================================================================================================
# Host port mapping (container always uses 9090 internally)
PORT_PROMETHEUS_HOST=9090
PROMETHEUS_RETENTION=30d
CONTAINER_PROMETHEUS=coroot_prometheus
CONTAINER_IP_PROMETHEUS=172.160.160.40

#================================================================================================
# CLICKHOUSE CONFIGURATION
#================================================================================================
# Host port mappings (container always uses 9000 and 8123 internally)
PORT_CLICKHOUSE_HOST=9000
PORT_CLICKHOUSE_HTTP_HOST=8123
CLICKHOUSE_DB=coroot
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CONTAINER_CLICKHOUSE=coroot_clickhouse
CONTAINER_IP_CLICKHOUSE=172.160.160.30

#================================================================================================
# AGENT CONFIGURATION
#================================================================================================
CONTAINER_NODE_AGENT=coroot_node_agent
CONTAINER_IP_NODE_AGENT=172.160.160.60
CONTAINER_CLUSTER_AGENT=coroot_cluster_agent
CONTAINER_IP_CLUSTER_AGENT=172.160.160.70

#================================================================================================
# PORTAINER CONFIGURATION
#================================================================================================
PORTAINER_VERSION=latest
# Host port mappings (container always uses 9000 and 9443 internally)
PORT_PORTAINER_HOST=5212
PORT_PORTAINER_HTTPS_HOST=9444
CONTAINER_PORTAINER=coroot_portainer
CONTAINER_IP_PORTAINER=172.160.160.5

#================================================================================================
# DATA DIRECTORIES (Optional: Comment out to use Docker managed volumes)
#================================================================================================
# DATA_PROMETHEUS=/opt/data/docker/coroot/prometheus
# DATA_CLICKHOUSE=/opt/data/docker/coroot/clickhouse
# DATA_CLICKHOUSE_LOGS=/opt/data/docker/coroot/clickhouse-logs
# DATA_COROOT=/opt/data/docker/coroot/coroot
# DATA_NODE_AGENT=/opt/data/docker/coroot/node-agent
# DATA_CLUSTER_AGENT=/opt/data/docker/coroot/cluster-agent